  "ui": {
    "workspace": "Dev workspace",
    "area": "Area",
    "areas": "Areas",
    "screenshotsTitle": "صور من الشغل",
    "cvTitle": "Software developer",
    "sample": { "id": "BUG-0142", "module": "BUGFIX", "type": "Bug fix", "title": "Checkout_double_charge", "code": "CHECKOUT_RETRY" },
    "placeholders": {
      "taskId": "BUG-0142",
      "taskTitle": "Fix double charge when checkout request is retried",
      "extraQuestions": "e.g. Should the payment API accept an idempotency key from the client?",
      "cardTopic": "Concept: Idempotency",
      "cardFact": "Repeating the same request has the same effect as sending it once; use an idempotency key so retries do not charge twice",
      "cardTags": "API, Payments, Idempotency",
      "scriptName": "fix_duplicate_orders.sql",
      "scriptPurpose": "One-off data fix for orders created twice",
      "checklistItem": "e.g. Failing test written",
