      "bullet": "{verb} {title} ({name}), [result: e.g. p95 latency cut from 800 to 200 ms / zero repeat incidents / test coverage up to N%]."
    },
    "cvTips": [
      { "title": "Action, what, result.", "text": "Start with a verb (Built, Fixed, Shipped, Designed), say what and end with the result." },
      { "title": "Numbers win.", "text": "Latency saved, users served, incidents reduced, deploy time cut, test coverage, PRs reviewed." },
      { "title": "Name the stack.", "text": "Languages, frameworks, databases and cloud services. Recruiters and ATS search for these exact words." },
      { "title": "Show impact, not tickets.", "text": "Say what changed for users or the team, not just which ticket you closed." },
      { "title": "Keep it confidential.", "text": "No internal service names, customer names or private repo links. Stranote flags these in amber." },
      { "title": "Keep it fresh.", "text": "Check this page every month and export a new version." }
    ]
  },
