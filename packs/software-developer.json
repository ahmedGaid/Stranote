      "Who reviews this?",
      "What is the deadline or target release?"
    ],
    "baseChecklist": [
      "Requirements understood",
      "Code written",
      "Tests added",
      "PR reviewed and merged",
      "Deployed and verified",
      "Notes saved in 01_Notes"
    ],
    "ticketFolders": ["01_Notes", "02_Code", "03_Tests", "04_Docs"],
    "notesSections": ["Decisions", "Commands and snippets", "Free notes"],
    "saveTargets": [
      { "name": "Notes or analysis", "path": "{ticket}\\01_Notes", "prefix": false },
