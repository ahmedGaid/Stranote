      { "name": "Test case or test data", "path": "{ticket}\\03_Tests", "prefix": false },
      { "name": "Design doc, ADR or diagram", "path": "{ticket}\\04_Docs", "prefix": false },
      { "name": "Reusable snippet (Knowledge base)", "path": "04_Knowledge\\Snippets", "prefix": false },
      { "name": "ADR or architecture note (Knowledge base)", "path": "04_Knowledge\\Architecture", "prefix": false }
    ],
