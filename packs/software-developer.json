  "onboardingQuestions": [
    { "id": "role", "label": "Main focus", "type": "select", "options": ["Frontend", "Backend", "Full-stack", "Mobile", "DevOps / SRE", "Data"], "default": "Full-stack", "writesTo": "pack.focus" },
    { "id": "languages", "label": "Main languages (e.g. TypeScript, C#, Python, Java)", "type": "text", "default": "", "writesTo": "pack.languages" },
