      },
      "bullet": "{verb} {title} ({name}), [result: e.g. zero medication errors / falls on the unit reduced by N% / N patients per shift]."
    },
    "cvTips": [
      { "title": "Action, what, result.", "text": "Start with a verb (Cared for, Administered, Led, Trained), say what and end with the result." },
      { "title": "Numbers win.", "text": "Patients per shift, beds in the unit, audit scores, falls or infections reduced, staff you trained." },
