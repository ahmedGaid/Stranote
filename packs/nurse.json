    { "id": "role", "label": "Your role", "type": "select", "options": ["Nursing student", "Staff nurse", "Charge nurse", "Nurse specialist", "Nurse educator", "Nurse manager"], "default": "Staff nurse", "writesTo": "pack.role" },
    { "id": "specialty", "label": "Specialty or patient group (e.g. cardiac, renal, neuro)", "type": "text", "default": "", "writesTo": "pack.specialty" },
